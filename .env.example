# Supabase Credentials (Required for free Vercel + Supabase deployment)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_service_role_key

# OpenRouter Vision AI Provider Configuration (Server Side Only - NEVER prefix with VITE_)
# Recommended Vision Models on OpenRouter:
# - google/gemini-2.0-flash-001
# - meta-llama/llama-3.2-11b-vision-instruct
# - openai/gpt-4o-mini
# - anthropic/claude-3.5-haiku
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Fallback AI Provider (Groq / OpenAI / Custom)
AI_API_KEY=your_groq_or_openai_api_key_here
AI_MODEL=llama-3.1-8b-instant
AI_API_URL=https://api.groq.com/openai/v1/chat/completions