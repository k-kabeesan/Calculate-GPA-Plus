# Server only. Required for shared profiles; never prefix the key with VITE_.
# Use a server-side Supabase secret key (sb_secret_...) or legacy service_role key.
# This is not the project URL or a publishable/anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional server-only scrypt hash. Lets an administrator edit or delete any profile.
# Generate with: node -e "const c=require('node:crypto');const s=c.randomBytes(16).toString('hex');console.log('scrypt$'+s+'$'+c.scryptSync(process.argv[1],s,64).toString('hex'))" "your-password"
ADMIN_PASSCODE_HASH=

# Optional browser API origin for separate hosting. Leave blank for local Vite or Vercel.
VITE_API_URL=
# Only needed when the browser and API run on different origins.
CLIENT_ORIGIN=
